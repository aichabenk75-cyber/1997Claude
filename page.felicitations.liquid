{% layout none %}
{% raw %}
<!DOCTYPE html>
<!--
  ════════════════════════════════════════════════════════════════════════════
  ML ACADEMY — PAGE DE FÉLICITATIONS / CONFIRMATION DE PAIEMENT
  ════════════════════════════════════════════════════════════════════════════
  Page affichée après la validation du paiement (produit digital, accès immédiat).

  👉 OÙ METTRE TON LIEN DE TÉLÉCHARGEMENT ?
     Cherche  data-download  /  id="downloadBtn"  plus bas et remplace le href="#"
     par le lien de ton produit (PDF, .zip, Google Drive, Notion, etc.).

  👉 INTÉGRATION SHOPIFY : voir le fichier INTEGRATION.md fourni à côté.
     (Méthode recommandée = template Liquid « page.felicitations.liquid ».)
  ════════════════════════════════════════════════════════════════════════════
-->
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Félicitations — Bienvenue dans le Lab | ML Academy</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<style>
/* ===== TOKENS — repris à l'identique du site ML Academy ===== */
.mla,.mla *,.mla *::before,.mla *::after{box-sizing:border-box;margin:0;padding:0}
.mla{
  --black:#0A0A0A;--white:#fff;
  --gray-400:#9CA3AF;--gray-500:#6B7280;--gray-700:#374151;
  --or:#F97316;--or-dark:#EA580C;--or-light:#FED7AA;
  --green:#16A34A;--green-l:#22C55E;--green-bg:#DCFCE7;
  --amber:#F59E0B;
  --radius:12px;--radius-sm:8px;--radius-lg:16px;--radius-full:100px;
  --t:.2s ease;
  --f:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
}
/* full-bleed : la page remplit l'écran même si Shopify l'insère dans un conteneur */
.mla{
  position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;width:100vw;
  min-height:100vh;background:var(--black);color:var(--white);
  font-family:var(--f);line-height:1.6;-webkit-font-smoothing:antialiased;
  overflow:hidden;padding:0 0 56px
}
/* fond standalone (ignoré quand inséré dans un thème) */
html,body{background:#0A0A0A}
.mla a{color:inherit;text-decoration:none}
.mla .wrap{max-width:760px;margin:0 auto;padding:0 24px;position:relative;z-index:2}

/* halo orange + motif de points (comme .hero / .cta-final du site) */
.mla::before{content:'';position:absolute;top:-260px;left:50%;transform:translateX(-50%);
  width:1100px;height:820px;background:radial-gradient(ellipse,rgba(249,115,22,.16) 0%,transparent 65%);
  pointer-events:none;z-index:0}
.mla::after{content:'';position:absolute;inset:0;
  background-image:radial-gradient(rgba(249,115,22,.05) 1px,transparent 1px);background-size:30px 30px;
  pointer-events:none;z-index:0}
.mla canvas.confetti{position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none}

/* ===== NAV / LOGO ===== */
.mla .top{display:flex;justify-content:center;padding:30px 24px 8px;position:relative;z-index:2}
.mla .logo{font-size:21px;font-weight:900;letter-spacing:-.03em;color:#fff}
.mla .logo em{color:var(--or);font-style:normal}

/* ===== HERO SUCCÈS ===== */
.mla .hero{text-align:center;padding:34px 0 8px}

/* coche animée */
.mla .badge{position:relative;width:118px;height:118px;margin:0 auto 30px}
.mla .badge .ring{position:absolute;inset:0;border-radius:50%;
  background:radial-gradient(circle,rgba(249,115,22,.35),transparent 70%);
  animation:pulse 2.4s ease-out infinite}
.mla .badge .disc{position:absolute;inset:14px;border-radius:50%;
  background:linear-gradient(145deg,#F97316,#F59E0B);
  box-shadow:0 14px 40px rgba(249,115,22,.55),inset 0 2px 6px rgba(255,255,255,.35);
  display:flex;align-items:center;justify-content:center;
  animation:pop .55s cubic-bezier(.2,1.5,.4,1) both}
.mla .badge svg{width:58px;height:58px}
.mla .badge .chk{fill:none;stroke:#fff;stroke-width:6;stroke-linecap:round;stroke-linejoin:round;
  stroke-dasharray:60;stroke-dashoffset:60;animation:draw .5s .45s ease forwards}
@keyframes pop{0%{transform:scale(0);opacity:0}100%{transform:scale(1);opacity:1}}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes pulse{0%{transform:scale(.85);opacity:.9}70%{transform:scale(1.35);opacity:0}100%{opacity:0}}

.mla .pill{display:inline-flex;align-items:center;gap:8px;background:rgba(22,163,74,.12);
  color:#4ADE80;border:1px solid rgba(34,197,94,.35);padding:8px 18px;border-radius:var(--radius-full);
  font-size:13px;font-weight:700;margin-bottom:22px}
.mla .pill .dot{width:8px;height:8px;border-radius:50%;background:#22C55E;
  box-shadow:0 0 0 0 rgba(34,197,94,.6);animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.7)}}

.mla h1{font-size:clamp(30px,5.4vw,52px);font-weight:900;letter-spacing:-.04em;line-height:1.08;
  margin-bottom:18px}
.mla h1 .hl{color:var(--or)}
.mla .sub{font-size:clamp(15px,2vw,18px);color:var(--gray-400);max-width:540px;margin:0 auto 36px;
  line-height:1.7}

/* ===== BOUTON TÉLÉCHARGER ===== */
.mla .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:800;
  cursor:pointer;border:none;transition:all var(--t);font-family:var(--f);line-height:1;text-decoration:none}
.mla .dl{position:relative;overflow:hidden;background:var(--or);color:#fff;font-size:19px;
  padding:22px 52px;border-radius:14px;box-shadow:0 8px 34px rgba(249,115,22,.5)}
.mla .dl:hover{background:var(--or-dark);transform:translateY(-2px);box-shadow:0 12px 42px rgba(249,115,22,.6)}
.mla .dl svg{width:22px;height:22px}
.mla .dl .arrow{transition:transform var(--t)}
.mla .dl:hover .arrow{transform:translateY(3px)}
/* reflet qui balaye */
.mla .dl::after{content:'';position:absolute;top:0;left:-120%;width:60%;height:100%;
  background:linear-gradient(120deg,transparent,rgba(255,255,255,.4),transparent);
  transform:skewX(-20deg);animation:shine 3.2s ease-in-out infinite}
@keyframes shine{0%,60%{left:-120%}80%,100%{left:160%}}
.mla .dl-note{font-size:13.5px;color:var(--gray-500);margin-top:18px;display:flex;
  align-items:center;justify-content:center;gap:18px;flex-wrap:wrap}
.mla .dl-note span{display:inline-flex;align-items:center;gap:6px}

/* ===== PROCHAINES ÉTAPES ===== */
.mla .tag{display:inline-block;font-size:12px;font-weight:700;color:var(--or);
  text-transform:uppercase;letter-spacing:.12em;margin-bottom:14px}
.mla .sec{padding:54px 0 0}
.mla .sec-hd{text-align:center;margin-bottom:34px}
.mla .sec-hd h2{font-size:clamp(22px,3.4vw,32px);font-weight:800;letter-spacing:-.03em}
.mla .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.mla .step{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);
  border-radius:var(--radius);padding:26px 22px;text-align:left;transition:transform var(--t),border-color var(--t)}
.mla .step:hover{transform:translateY(-3px);border-color:rgba(249,115,22,.45)}
.mla .step .n{width:42px;height:42px;border-radius:11px;background:rgba(249,115,22,.14);
  color:var(--or);font-weight:800;font-size:17px;display:flex;align-items:center;justify-content:center;
  margin-bottom:16px}
.mla .step h3{font-size:16px;font-weight:700;margin-bottom:7px;letter-spacing:-.02em}
.mla .step p{font-size:13.5px;color:var(--gray-400);line-height:1.6}
.mla .step .mini{display:inline-flex;align-items:center;gap:6px;margin-top:14px;font-size:13px;
  font-weight:700;color:var(--or)}
.mla .step .mini:hover{color:var(--or-light)}

/* ===== ACCÈS DÉBLOQUÉ ===== */
.mla .unlock{margin-top:18px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);
  border-radius:var(--radius-lg);padding:30px 34px}
.mla .unlock h3{font-size:16px;font-weight:800;margin-bottom:20px;display:flex;align-items:center;gap:9px}
.mla .ulist{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:13px 28px}
.mla .ulist li{display:flex;align-items:center;gap:11px;font-size:14.5px;color:#E5E7EB}
.mla .ulist .ck{width:22px;height:22px;border-radius:50%;background:rgba(34,197,94,.15);
  color:#4ADE80;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;flex-shrink:0}

/* ===== SUPPORT / TRUST ===== */
.mla .trust{display:flex;justify-content:center;gap:28px;flex-wrap:wrap;margin-top:38px;
  padding-top:28px;border-top:1px solid rgba(255,255,255,.07)}
.mla .trust-item{display:flex;align-items:center;gap:8px;font-size:13.5px;color:var(--gray-400)}
.mla .support{text-align:center;margin-top:18px;font-size:13.5px;color:var(--gray-500)}
.mla .support a{color:var(--or);font-weight:600}

/* ===== FOOTER (repris à l'identique de la page produit) ===== */
.mla .footer{margin-top:50px;padding-top:40px;border-top:1px solid rgba(255,255,255,.08)}
.mla .footer-top{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:32px;margin-bottom:32px}
.mla .footer-logo{font-size:20px;font-weight:900;color:#fff;letter-spacing:-.03em}
.mla .footer-logo em{color:var(--or);font-style:normal}
.mla .footer-desc{font-size:13px;color:rgba(255,255,255,.4);margin-top:8px;max-width:300px;line-height:1.65}
.mla .footer-links{display:flex;gap:22px;flex-wrap:wrap;align-items:center}
.mla .footer-links a{color:rgba(255,255,255,.5);font-size:13.5px;transition:color var(--t)}
.mla .footer-links a:hover{color:#fff}
.mla .footer-btm{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;padding-top:22px;border-top:1px solid rgba(255,255,255,.07);font-size:12.5px;color:rgba(255,255,255,.3)}

/* ===== REVEAL (comme le site) — visible par défaut, animé seulement si JS actif ===== */
.mla .r{transition:opacity .6s ease,transform .6s ease}
.mla.anim .r{opacity:0;transform:translateY(22px)}
.mla.anim .r.in{opacity:1;transform:translateY(0)}
.mla .d1{transition-delay:.1s}.mla .d2{transition-delay:.2s}.mla .d3{transition-delay:.3s}

/* ===== RESPONSIVE ===== */
@media(max-width:680px){
  .mla .steps{grid-template-columns:1fr}
  .mla .ulist{grid-template-columns:1fr}
  .mla .dl{width:100%;padding:20px 28px;font-size:17px}
  .mla .wrap{padding:0 18px}
  .mla .footer-top{flex-direction:column;gap:18px}
}
@media(prefers-reduced-motion:reduce){
  .mla .dl::after,.mla .badge .ring{animation:none}
  .mla .badge .disc,.mla .badge .chk{animation-duration:.01s}
}
</style>
</head>
<body>

<div class="mla">
  <canvas class="confetti" id="confetti"></canvas>

  <!-- LOGO -->
  <div class="top">
    <a href="/" class="logo">ML <em>ACADEMY</em></a>
  </div>

  <div class="wrap">

    <!-- HERO SUCCÈS -->
    <section class="hero">
      <div class="badge">
        <span class="ring"></span>
        <span class="disc">
          <svg viewBox="0 0 52 52" aria-hidden="true">
            <path class="chk" d="M14 27 l8 8 l16 -18"/>
          </svg>
        </span>
      </div>

      <div class="pill r"><span class="dot"></span> Paiement confirmé</div>

      <h1 class="r d1">Félicitations 🎉<br>Bienvenue dans <span class="hl">le Lab</span> !</h1>
      <p class="sub r d2">Ton paiement a bien été validé. Ton accès est débloqué — tu peux
        télécharger ton pack immédiatement et commencer dès maintenant.</p>

      <!-- 👇👇👇  REMPLACE href="#" PAR TON LIEN DE TÉLÉCHARGEMENT  👇👇👇 -->
      <a id="downloadBtn" data-download href="#" download
         class="btn dl r d2">
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M5 21h14"/>
        </svg>
        Télécharger mon pack
      </a>
      <!-- 👆👆👆  REMPLACE href="#" PAR TON LIEN DE TÉLÉCHARGEMENT  👆👆👆 -->

      <div class="dl-note r d3">
        <span>📩 Lien aussi envoyé par email</span>
        <span>♾️ Accès à vie</span>
        <span>🔄 Mises à jour incluses</span>
      </div>
    </section>

    <!-- PROCHAINES ÉTAPES -->
    <section class="sec">
      <div class="sec-hd r">
        <div class="tag">Et maintenant ?</div>
        <h2>Tes 3 prochaines étapes</h2>
      </div>
      <div class="steps">
        <div class="step r">
          <div class="n">1</div>
          <h3>Télécharge ton pack</h3>
          <p>Récupère tout le contenu en un clic et garde-le précieusement. Tu y as accès à vie.</p>
        </div>
        <div class="step r d1">
          <div class="n">2</div>
          <h3>Rejoins le Discord VIP</h3>
          <p>Accède à la communauté privée : bons plans, niches et entraide des membres au quotidien.</p>
        </div>
        <div class="step r d2">
          <div class="n">3</div>
          <h3>Passe à l'action</h3>
          <p>Suis la méthode étape par étape. Le plus dur est fait — il ne te reste qu'à te lancer.</p>
          <span class="mini" style="color:var(--gray-500);cursor:default">🚀 C'est parti</span>
        </div>
      </div>

      <!-- ACCÈS DÉBLOQUÉ -->
      <div class="unlock r">
        <h3>🔓 Ton accès débloqué</h3>
        <ul class="ulist">
          <li><span class="ck">✓</span>Accès aux sources chinoises exclusives</li>
          <li><span class="ck">✓</span>Méthode agent clé en main</li>
          <li><span class="ck">✓</span>1000+ fournisseurs vérifiés</li>
          <li><span class="ck">✓</span>Discord VIP à vie</li>
          <li><span class="ck">✓</span>Bonus : 10 niches rentables</li>
          <li><span class="ck">✓</span>Mises à jour incluses à vie</li>
        </ul>
      </div>

      <!-- TRUST -->
      <div class="trust r">
        <div class="trust-item">🔒 Paiement 100% sécurisé</div>
        <div class="trust-item">⚡ Accès instantané</div>
        <div class="trust-item">📞 SAV français 7j/7</div>
      </div>
      <p class="support r">Un souci pour télécharger ? Écris-nous à
        <a href="mailto:contact@mlacademy.fr">contact@mlacademy.fr</a> — réponse en moins de 24h.</p>
    </section>

    <!-- FOOTER (identique à la page produit — liens légaux toujours accessibles) -->
    <footer class="footer">
      <div class="footer-top">
        <div>
          <div class="footer-logo">ML <em>ACADEMY</em></div>
          <p class="footer-desc">L'accompagnement pour apprendre à gagner de l'argent en important depuis la Chine et en revendant en France.</p>
        </div>
        <div class="footer-links">
          <a href="/pages/contact">Contact</a>
          <a href="/pages/mentions-legales">Mentions légales</a>
          <a href="/pages/cgv">CGV</a>
          <a href="/pages/confidentialite">Confidentialité</a>
        </div>
      </div>
      <div class="footer-btm">
        <span>© 2026 ML Academy. Tous droits réservés.</span>
        <span>Fait pour les revendeurs ambitieux 🔥</span>
      </div>
    </footer>

  </div>
</div>

<script>
(function(){
  var root=document.querySelector('.mla');

  /* ----- Reveal au scroll (identique au site) — progressif & sûr -----
     Le contenu est visible par défaut ; on ne le cache pour l'animer que si
     IntersectionObserver est dispo, avec un filet de sécurité qui révèle tout. */
  if('IntersectionObserver' in window){
    root.classList.add('anim');
    var obs=new IntersectionObserver(function(es){
      es.forEach(function(e){if(e.isIntersecting)e.target.classList.add('in');});
    },{threshold:.12});
    root.querySelectorAll('.r').forEach(function(el){obs.observe(el);});
    /* révèle immédiatement ce qui est déjà à l'écran */
    requestAnimationFrame(function(){root.querySelectorAll('.r').forEach(function(el){
      if(el.getBoundingClientRect().top<window.innerHeight)el.classList.add('in');});});
    /* filet de sécurité : rien ne reste jamais invisible */
    setTimeout(function(){root.querySelectorAll('.r').forEach(function(el){el.classList.add('in');});},2600);
  }

  /* ----- Confettis (burst ~3s, puis stop) ----- */
  if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  var cv=document.getElementById('confetti'),ctx=cv.getContext('2d');
  function size(){cv.width=root.offsetWidth;cv.height=root.offsetHeight;}
  size();window.addEventListener('resize',size);
  var colors=['#F97316','#F59E0B','#FED7AA','#22C55E','#ffffff'];
  var P=[],N=140;
  for(var i=0;i<N;i++){
    P.push({x:Math.random()*cv.width,y:Math.random()*-cv.height,
      w:6+Math.random()*7,h:9+Math.random()*9,
      c:colors[(Math.random()*colors.length)|0],
      vy:2.4+Math.random()*3.2,vx:-1.5+Math.random()*3,
      rot:Math.random()*6.28,vr:-.18+Math.random()*.36});
  }
  var start=Date.now(),DUR=3000;
  function tick(){
    var t=Date.now()-start;ctx.clearRect(0,0,cv.width,cv.height);
    var fade=t>DUR-700?Math.max(0,(DUR-t)/700):1;
    P.forEach(function(p){
      p.y+=p.vy;p.x+=p.vx;p.rot+=p.vr;
      ctx.save();ctx.globalAlpha=fade;ctx.translate(p.x,p.y);ctx.rotate(p.rot);
      ctx.fillStyle=p.c;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore();
    });
    if(t<DUR)requestAnimationFrame(tick);
    else ctx.clearRect(0,0,cv.width,cv.height);
  }
  requestAnimationFrame(tick);

  /* ----- Garde-fou : prévient si le lien de téléchargement n'a pas été configuré ----- */
  var dl=document.getElementById('downloadBtn');
  dl.addEventListener('click',function(e){
    var href=dl.getAttribute('href');
    if(!href||href==='#'){e.preventDefault();
      alert('⚠️ Lien de téléchargement non configuré.\n\nOuvre le code et remplace href="#" du bouton (id="downloadBtn") par le lien de ton produit.');}
  });
})();
</script>
</body>
</html>

{% endraw %}
