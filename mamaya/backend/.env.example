# Backend Mamaya — configuration locale SANS Docker.
# Copie ce fichier en ".env" (même dossier) et remplis les valeurs.

# Neon (https://neon.tech) → crée un projet → copie la "Connection string"
# (mode "Pooled connection" recommandé). Doit commencer par postgres://
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Upstash (https://upstash.com) → crée une base Redis → copie l'URL "rediss://..."
REDIS_URL=rediss://default:xxxxx@xxxx.upstash.io:6379

# Secrets de DEV — génère-les avec les commandes ci-dessous (PowerShell) :
#   [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256})) → DEV_MASTER_KEY
#   -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })      → GEO_JITTER_SECRET
DEV_MASTER_KEY=
GEO_JITTER_SECRET=

JWT_KID=k1
# Génère la paire avec : openssl genpkey -algorithm ed25519 -out jwt.pem
#                        openssl pkey -in jwt.pem -pubout -out jwt-pub.pem
# Colle le contenu des fichiers ici (garde les \n littéraux si sur une ligne).
JWT_PRIVATE_PEM=
JWT_PUBLIC_PEM=

# Optionnel : sans clé, la modération auto-approuve les contenus (voir ci-dessous).
ANTHROPIC_API_KEY=
MODERATION_DEV_AUTO_APPROVE=true

PORT=3000
