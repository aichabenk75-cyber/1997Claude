{
  "name": "mamaya-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Mamaya — API du réseau social pour mères et futures mères 🤱",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
